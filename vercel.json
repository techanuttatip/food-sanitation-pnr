{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/line-webhook",
      "destination": "/api/line-webhook.js"
    },
    {
      "source": "/liff",
      "destination": "/index.html"
    },
    {
      "source": "/liff/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/line-api/(.*)",
      "destination": "https://api.line.me/$1"
    },
    {
      "source": "/webhook-site/(.*)",
      "destination": "https://webhook.site/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

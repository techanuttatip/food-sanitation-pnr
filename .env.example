# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Local Development Demo Mode (set to 'true' if Supabase credentials are not yet configured)
VITE_DEMO_MODE=true

# Organization Defaults
VITE_DEFAULT_ORG_NAME="องค์การบริหารส่วนตำบลตัวอย่าง"
VITE_DEFAULT_ORG_CODE="OBT-001"

# Public URL for QR verification
VITE_PUBLIC_APP_URL=http://localhost:5173
